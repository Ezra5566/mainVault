# Auto‑generated placeholder env file
# Copy this file and replace values with your real credentials

# PostgreSQL (matches defaults in docker‑compose.yml)
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_pass
POSTGRES_DB=pipeline_db

# Twitter API bearer token – replace with real token
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Reddit API credentials – replace with real credentials
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=python:data-pipeline:v1.0 (by /u/your_username)

# Optional: path to the best‑model checkpoint (will be set by training step)
MODEL_PATH=model_best.pth

# Optional: Spark master string (local by default)
SPARK_MASTER=local[4]
